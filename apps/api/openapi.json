{
	"openapi": "3.0.3",
	"info": {
		"title": "Another To Do API",
		"version": "0.0.0",
		"description": "REST and MCP API for Another To Do. All endpoints except discovery require a Cognito access token."
	},
	"security": [
		{
			"bearerAuth": []
		}
	],
	"paths": {
		"/tasks": {
			"get": {
				"operationId": "listTasks",
				"summary": "List the caller's tasks",
				"responses": {
					"200": {
						"description": "Tasks ordered by creation time",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/TaskList"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
				},
				"parameters": [
					{
						"name": "listId",
						"in": "query",
						"required": false,
						"schema": {
							"type": "string",
							"minLength": 1
						}
					}
				]
			},
			"post": {
				"operationId": "createTask",
				"summary": "Create a task",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CreateTask"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "The created task",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Task"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
				}
			}
		},
		"/tasks/{id}": {
			"parameters": [
				{
					"$ref": "#/components/parameters/TaskId"
				}
			],
			"get": {
				"operationId": "getTask",
				"summary": "Get a task",
				"responses": {
					"200": {
						"description": "The task",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Task"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
				}
			},
			"patch": {
				"operationId": "updateTask",
				"summary": "Update a task",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/UpdateTask"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "The updated task",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Task"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
				}
			},
			"delete": {
				"operationId": "deleteTask",
				"summary": "Delete a task",
				"responses": {
					"204": {
						"description": "Deleted"
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
				}
			}
		},
		"/mcp": {
			"post": {
				"operationId": "mcp",
				"summary": "Model Context Protocol endpoint (JSON-RPC 2.0)",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "JSON-RPC response",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					},
					"202": {
						"description": "Notification accepted"
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
				}
			}
		},
		"/.well-known/oauth-protected-resource": {
			"get": {
				"operationId": "protectedResourceMetadata",
				"summary": "OAuth protected resource metadata for MCP clients",
				"security": [],
				"responses": {
					"200": {
						"description": "Metadata",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ProtectedResourceMetadata"
								}
							}
						}
					}
				}
			}
		},
		"/lists": {
			"get": {
				"operationId": "listLists",
				"summary": "List the caller's lists",
				"responses": {
					"200": {
						"description": "Lists ordered by creation time",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/TodoListCollection"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
				}
			},
			"post": {
				"operationId": "createList",
				"summary": "Create a list",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CreateList"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "The created list",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/TodoList"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
				}
			}
		},
		"/lists/{id}": {
			"parameters": [
				{
					"$ref": "#/components/parameters/ResourceId"
				}
			],
			"get": {
				"operationId": "getList",
				"summary": "Get a list",
				"responses": {
					"200": {
						"description": "The list",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/TodoList"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
				}
			},
			"patch": {
				"operationId": "renameList",
				"summary": "Rename a list",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/UpdateList"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "The updated list",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/TodoList"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
				}
			},
			"delete": {
				"operationId": "deleteList",
				"summary": "Delete a list and its tasks",
				"responses": {
					"204": {
						"description": "Deleted"
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
				}
			}
		},
		"/view-settings": {
			"get": {
				"operationId": "listViewSettings",
				"summary": "List the caller's per-view settings (sort, hide completed, theme)",
				"responses": {
					"200": {
						"description": "Settings",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ViewSettingsCollection"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
				}
			}
		},
		"/view-settings/{id}": {
			"parameters": [
				{
					"$ref": "#/components/parameters/ResourceId"
				}
			],
			"put": {
				"operationId": "putViewSettings",
				"summary": "Replace the settings of a view (a list id or a built in view such as my-day)",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/PutViewSettings"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "The stored settings",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ViewSettings"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
				}
			}
		},
		"/photos": {
			"get": {
				"operationId": "listPhotos",
				"summary": "List the caller's uploaded photos with short lived download links",
				"responses": {
					"200": {
						"description": "Photos",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PhotoCollection"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
				}
			},
			"post": {
				"operationId": "createPhoto",
				"summary": "Register a photo and get a signed form to upload it to storage",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CreatePhoto"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "The photo and the upload form",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/CreatedPhoto"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
				}
			}
		},
		"/photos/{id}": {
			"parameters": [
				{
					"$ref": "#/components/parameters/ResourceId"
				}
			],
			"delete": {
				"operationId": "deletePhoto",
				"summary": "Permanently delete a photo and clear any theme that uses it",
				"responses": {
					"204": {
						"description": "Deleted"
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
				}
			}
		}
	},
	"components": {
		"securitySchemes": {
			"bearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT"
			}
		},
		"parameters": {
			"TaskId": {
				"name": "id",
				"in": "path",
				"required": true,
				"schema": {
					"type": "string",
					"minLength": 1
				}
			},
			"ResourceId": {
				"name": "id",
				"in": "path",
				"required": true,
				"schema": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"responses": {
			"Error": {
				"description": "Error",
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/Error"
						}
					}
				}
			}
		},
		"schemas": {
			"Importance": {
				"type": "string",
				"enum": ["normal", "high"]
			},
			"Task": {
				"type": "object",
				"required": [
					"id",
					"title",
					"completed",
					"importance",
					"dueDate",
					"createdAt",
					"listId",
					"myDay",
					"myDayDismissed",
					"steps",
					"note"
				],
				"properties": {
					"id": {
						"type": "string"
					},
					"title": {
						"type": "string"
					},
					"completed": {
						"type": "boolean"
					},
					"importance": {
						"$ref": "#/components/schemas/Importance"
					},
					"dueDate": {
						"type": "string",
						"format": "date-time",
						"nullable": true
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"listId": {
						"type": "string",
						"nullable": true
					},
					"myDay": {
						"type": "string",
						"pattern": "^\\d{4}-\\d{2}-\\d{2}$",
						"nullable": true,
						"description": "Day (YYYY-MM-DD) the task was added to My Day"
					},
					"myDayDismissed": {
						"type": "string",
						"pattern": "^\\d{4}-\\d{2}-\\d{2}$",
						"nullable": true,
						"description": "Day (YYYY-MM-DD) the user removed the task from My Day, so a due date does not add it back that day"
					},
					"steps": {
						"type": "array",
						"maxItems": 100,
						"items": {
							"$ref": "#/components/schemas/TaskStep"
						}
					},
					"note": {
						"type": "string",
						"maxLength": 10000
					}
				}
			},
			"TaskList": {
				"type": "object",
				"required": ["tasks"],
				"properties": {
					"tasks": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/Task"
						}
					}
				}
			},
			"CreateTask": {
				"type": "object",
				"required": ["title"],
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[A-Za-z0-9_-]{1,64}$",
						"description": "Optional client generated id that makes creation idempotent"
					},
					"title": {
						"type": "string",
						"minLength": 1
					},
					"completed": {
						"type": "boolean"
					},
					"importance": {
						"$ref": "#/components/schemas/Importance"
					},
					"dueDate": {
						"type": "string",
						"format": "date-time",
						"nullable": true
					},
					"listId": {
						"type": "string",
						"minLength": 1,
						"nullable": true
					},
					"myDay": {
						"type": "string",
						"pattern": "^\\d{4}-\\d{2}-\\d{2}$",
						"nullable": true,
						"description": "Day (YYYY-MM-DD) the task was added to My Day"
					},
					"myDayDismissed": {
						"type": "string",
						"pattern": "^\\d{4}-\\d{2}-\\d{2}$",
						"nullable": true,
						"description": "Day (YYYY-MM-DD) the user removed the task from My Day, so a due date does not add it back that day"
					},
					"steps": {
						"type": "array",
						"maxItems": 100,
						"items": {
							"$ref": "#/components/schemas/TaskStep"
						}
					},
					"note": {
						"type": "string",
						"maxLength": 10000
					}
				}
			},
			"UpdateTask": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"title": {
						"type": "string",
						"minLength": 1
					},
					"completed": {
						"type": "boolean"
					},
					"importance": {
						"$ref": "#/components/schemas/Importance"
					},
					"dueDate": {
						"type": "string",
						"format": "date-time",
						"nullable": true
					},
					"listId": {
						"type": "string",
						"minLength": 1,
						"nullable": true
					},
					"myDay": {
						"type": "string",
						"pattern": "^\\d{4}-\\d{2}-\\d{2}$",
						"nullable": true,
						"description": "Day (YYYY-MM-DD) the task was added to My Day"
					},
					"myDayDismissed": {
						"type": "string",
						"pattern": "^\\d{4}-\\d{2}-\\d{2}$",
						"nullable": true,
						"description": "Day (YYYY-MM-DD) the user removed the task from My Day, so a due date does not add it back that day"
					},
					"steps": {
						"type": "array",
						"maxItems": 100,
						"items": {
							"$ref": "#/components/schemas/TaskStep"
						}
					},
					"note": {
						"type": "string",
						"maxLength": 10000
					}
				}
			},
			"Error": {
				"type": "object",
				"required": ["error"],
				"properties": {
					"error": {
						"type": "string"
					}
				}
			},
			"ProtectedResourceMetadata": {
				"type": "object",
				"required": ["resource", "authorization_servers"],
				"properties": {
					"resource": {
						"type": "string"
					},
					"authorization_servers": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"bearer_methods_supported": {
						"type": "array",
						"items": {
							"type": "string"
						}
					}
				}
			},
			"TodoList": {
				"type": "object",
				"required": ["id", "name", "createdAt"],
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					}
				}
			},
			"TodoListCollection": {
				"type": "object",
				"required": ["lists"],
				"properties": {
					"lists": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/TodoList"
						}
					}
				}
			},
			"CreateList": {
				"type": "object",
				"required": ["name"],
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[A-Za-z0-9_-]{1,64}$",
						"description": "Optional client generated id that makes creation idempotent"
					},
					"name": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"UpdateList": {
				"type": "object",
				"required": ["name"],
				"additionalProperties": false,
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"TaskStep": {
				"type": "object",
				"required": ["id", "title", "completed"],
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[A-Za-z0-9_-]{1,64}$"
					},
					"title": {
						"type": "string",
						"minLength": 1,
						"maxLength": 256
					},
					"completed": {
						"type": "boolean"
					}
				}
			},
			"ViewSettings": {
				"type": "object",
				"required": ["id", "sort", "hideCompleted", "theme", "updatedAt"],
				"properties": {
					"id": {
						"type": "string"
					},
					"sort": {
						"type": "string",
						"nullable": true,
						"enum": ["importance", "alphabetical", "due", "created", "myDay", null]
					},
					"hideCompleted": {
						"type": "boolean"
					},
					"theme": {
						"type": "object",
						"nullable": true,
						"required": ["type"],
						"additionalProperties": false,
						"properties": {
							"type": {
								"type": "string",
								"enum": ["color", "photo"]
							},
							"color": {
								"type": "string",
								"pattern": "^#[0-9a-fA-F]{6}$"
							},
							"photoId": {
								"type": "string",
								"pattern": "^[A-Za-z0-9_-]{1,64}$"
							}
						}
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					}
				}
			},
			"ViewSettingsCollection": {
				"type": "object",
				"required": ["settings"],
				"properties": {
					"settings": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/ViewSettings"
						}
					}
				}
			},
			"PutViewSettings": {
				"type": "object",
				"required": ["sort", "hideCompleted", "theme"],
				"additionalProperties": false,
				"properties": {
					"sort": {
						"type": "string",
						"nullable": true,
						"enum": ["importance", "alphabetical", "due", "created", "myDay", null]
					},
					"hideCompleted": {
						"type": "boolean"
					},
					"theme": {
						"type": "object",
						"nullable": true,
						"required": ["type"],
						"additionalProperties": false,
						"properties": {
							"type": {
								"type": "string",
								"enum": ["color", "photo"]
							},
							"color": {
								"type": "string",
								"pattern": "^#[0-9a-fA-F]{6}$"
							},
							"photoId": {
								"type": "string",
								"pattern": "^[A-Za-z0-9_-]{1,64}$"
							}
						}
					}
				}
			},
			"Photo": {
				"type": "object",
				"required": ["id", "name", "contentType", "size", "createdAt", "url"],
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"contentType": {
						"type": "string"
					},
					"size": {
						"type": "integer"
					},
					"createdAt": {
						"type": "string",
						"format": "date-time"
					},
					"url": {
						"type": "string"
					}
				}
			},
			"PhotoCollection": {
				"type": "object",
				"required": ["photos"],
				"properties": {
					"photos": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/Photo"
						}
					}
				}
			},
			"CreatePhoto": {
				"type": "object",
				"required": ["name", "contentType", "size"],
				"additionalProperties": false,
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1,
						"maxLength": 120
					},
					"contentType": {
						"type": "string",
