				"summary": "Get a group",
				"responses": {
					"200": {
						"description": "The group",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Group"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
