									},
									"email": {
										"type": "string"
									}
								}
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Created",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": [
										"username",
										"email"
									],
									"properties": {
										"username": {
											"type": "string"
										},
										"email": {
											"type": "string",
											"nullable": true
										}
									}
								}
							}
						}
					},
					"403": {
						"description": "Not an administrator"
					}
				}
			}
		},
