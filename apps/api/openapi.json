		"/config": {
			"get": {
				"operationId": "getConfig",
				"summary": "How clients should connect to this server",
				"security": [],
				"responses": {
					"200": {
						"description": "Server configuration",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": [
										"authentication",
										"providers",
										"notice",
										"realtimeUrl",
										"signIn",
										"maxUploadBytes",
										"defaultSettings",
										"presetThemes"
									],
									"properties": {
										"authentication": {
											"type": "string",
											"enum": [
												"none",
												"password",
												"external"
											]
										},
										"providers": {
											"type": "array",
											"items": {
												"type": "string",
												"enum": [
													"Microsoft"
												]
											}
										},
										"notice": {
											"type": "string",
											"nullable": true
										},
										"realtimeUrl": {
											"type": "string",
											"nullable": true
										},
										"defaultSettings": {
											"$ref": "#/components/schemas/DefaultSettings"
										},
										"presetThemes": {
											"type": "boolean",
											"description": "Whether view settings accept the photos that ship with the apps"
										},
										"maxUploadBytes": {
											"type": "integer",
											"description": "The largest file the server accepts; photos are also limited to 5 MB"
										},
										"signIn": {
											"type": "object",
											"nullable": true,
											"description": "Where an app signs in when authentication is external",
											"required": [
												"url",
												"clientId"
											],
											"properties": {
												"url": {
													"type": "string"
												},
												"clientId": {
													"type": "string"
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"/auth/login": {
			"post": {
				"operationId": "login",
				"summary": "Sign in with a username and password (servers with their own accounts)",
				"security": [],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": [
									"username",
									"password"
								],
								"properties": {
									"username": {
										"type": "string"
									},
									"password": {
										"type": "string"
									}
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Signed in",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": [
										"tokenType",
										"accessToken",
										"expiresIn"
									],
									"properties": {
										"tokenType": {
											"type": "string",
											"enum": [
												"Bearer"
											]
										},
										"accessToken": {
											"type": "string"
										},
										"expiresIn": {
											"type": "integer"
										}
									}
								}
							}
						}
					},
					"401": {
						"description": "Invalid username or password"
					}
				}
			}
		},
		"/auth/users": {
			"post": {
				"operationId": "createUser",
