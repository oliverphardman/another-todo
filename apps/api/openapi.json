					"204": {
						"description": "Deleted"
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
				}
			}
		},
		"/mcp": {
			"post": {
				"operationId": "mcp",
				"summary": "Model Context Protocol endpoint (JSON-RPC 2.0)",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "JSON-RPC response",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					},
					"202": {
						"description": "Notification accepted"
					},
					"default": {
						"$ref": "#/components/responses/Error"
					}
				}
			}
		},
