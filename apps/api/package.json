{
	"name": "@atd/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "eslint . && tsc --noEmit",
		"test": "vitest run --coverage",
		"format": "prettier --check .",
		"build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.mjs",
		"generate": "openapi-typescript openapi.json -o src/generated/api.ts",
		"test:integration": "vitest run -c vitest.integration.config.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/aws-lambda": "^8.10.164",
		"@types/express": "^4.17.25",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "^3.2.4",
		"esbuild": "^0.28.2",
		"eslint": "^10.15.0",
		"globals": "^17.14.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.6.2",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.73.0",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"@aws-sdk/client-dynamodb": "^3.1171.0",
		"@aws-sdk/lib-dynamodb": "^3.1171.0",
		"@codegenie/serverless-express": "^5.0.0",
		"express": "^4.22.3",
		"express-openapi-validator": "^5.6.2"
	}
}
