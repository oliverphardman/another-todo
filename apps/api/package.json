{
	"name": "@atd/api",
	"version": "1.6.0",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "eslint . && tsc --noEmit",
		"test": "vitest run --coverage",
		"format": "prettier --check .",
		"build": "node build.mjs",
		"generate": "openapi-typescript openapi.json -o src/generated/api.ts",
		"test:integration": "vitest run -c vitest.integration.config.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/express": "^4.17.25",
		"@types/node": "^22.20.5",
		"@types/ws": "^8.18.2",
		"@vitest/coverage-v8": "^4.1.12",
		"esbuild": "^0.28.2",
		"eslint": "^10.15.0",
		"globals": "^17.14.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.6.2",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.73.0",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@aws-sdk/client-apigatewaymanagementapi": "^3.1171.0",
		"@aws-sdk/client-cognito-identity-provider": "^3.1171.0",
		"@aws-sdk/client-dynamodb": "^3.1171.0",
		"@aws-sdk/client-s3": "^3.1171.0",
		"@aws-sdk/lib-dynamodb": "^3.1171.0",
		"@aws-sdk/s3-presigned-post": "^3.1171.0",
		"@aws-sdk/s3-request-presigner": "^3.1171.0",
		"aws-jwt-verify": "^5.2.1",
		"express": "^4.22.3",
		"express-openapi-validator": "^5.6.2",
		"ws": "^8.23.0"
	}
}
