{
	"expo": {
		"name": "Another To Do",
		"description": "It's just Another To Do app. What did you expect?",
		"slug": "another-todo",
		"scheme": "anothertodo",
		"version": "1.6.0",
		"orientation": "default",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "dev.oliverhardman.anothertodo"
		},
		"android": {
			"package": "dev.oliverhardman.anothertodo",
			"adaptiveIcon": {
				"foregroundImage": "./assets/brand/adaptive-foreground.png",
				"backgroundColor": "#2564cf"
			}
		},
		"web": {
			"bundler": "metro",
			"output": "single",
			"name": "Another To Do",
			"themeColor": "#2564cf",
			"favicon": "./assets/favicon.png",
			"shortName": "Another To Do",
			"description": "It's just Another To Do app. What did you expect?",
			"backgroundColor": "#1e1e1e",
			"lang": "en"
		},
		"plugins": [
			"expo-audio",
			"expo-notifications",
			"expo-localization",
			"expo-secure-store",
			"expo-web-browser",
			"expo-asset",
			[
				"expo-font",
				{
					"android": {
						"fonts": [
							{
								"fontFamily": "Selawik",
								"fontDefinitions": [
									{
										"path": "./assets/fonts/selawk.ttf",
										"weight": 400
									},
									{
										"path": "./assets/fonts/selawksb.ttf",
										"weight": 600
									},
									{
										"path": "./assets/fonts/selawkb.ttf",
										"weight": 700
									}
								]
							}
						]
					},
					"ios": {
						"fonts": [
							"./assets/fonts/selawk.ttf",
							"./assets/fonts/selawksb.ttf",
							"./assets/fonts/selawkb.ttf"
						]
					}
				}
			],
			"@react-native-community/datetimepicker"
		],
		"icon": "./assets/brand/icon-1024.png"
	}
}
