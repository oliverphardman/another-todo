{
	"name": "@atd/client",
	"version": "0.0.0",
	"private": true,
	"main": "index.ts",
	"scripts": {
		"start": "expo start",
		"web": "expo start --web",
		"ios": "expo run:ios",
		"android": "expo run:android",
		"build": "expo export --platform web",
		"generate": "openapi-typescript ../api/openapi.json -o src/generated/api.ts",
		"lint": "eslint . && tsc --noEmit",
		"test": "vitest run --coverage",
		"format": "prettier --check .",
		"macos": "react-native run-macos",
		"windows": "react-native run-windows",
		"pods": "pod install --project-directory=macos"
	},
	"dependencies": {
		"@react-native-async-storage/async-storage": "^2.2.0",
		"@react-native-community/datetimepicker": "8.6.0",
		"@react-native-community/netinfo": "^11.4.1",
		"expo": "55.0.32",
		"expo-asset": "~55.0.20",
		"expo-audio": "~55.0.18",
		"expo-auth-session": "~55.0.19",
		"expo-constants": "~55.0.17",
		"expo-crypto": "55.0.19",
		"expo-image-picker": "^55.0.24",
		"expo-localization": "^55.0.19",
		"expo-print": "^55.0.19",
		"expo-secure-store": "~55.0.18",
		"expo-status-bar": "~55.0.6",
		"expo-web-browser": "~55.0.20",
		"react": "19.2.0",
		"react-dom": "19.2.0",
		"react-native": "0.83.10",
		"react-native-macos": "0.83.0",
		"react-native-safe-area-context": "~5.6.2",
		"react-native-svg": "^15.15.3",
		"react-native-web": "^0.21.4",
		"react-native-windows": "0.83.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@react-native-community/cli": "^21.0.0",
		"@react-native/metro-config": "0.83.10",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^26.6.6",
		"@types/react": "~19.2.18",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"jsdom": "^27.0.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.10",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0",
		"vitest": "^5.0.5"
	}
}
