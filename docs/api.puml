@startuml api
title Another To Do API

skinparam componentStyle rectangle

actor "Client\n(Expo app / MCP client)" as Client

cloud "AWS" {
  component "Amazon Cognito\nuser pool + hosted UI" as Cognito

  package "Lambda Web Function (Express, ApplicationManaged auth)" {
    component "CorsPolicy" as Cors
    component "BearerAuthenticator\n+ CognitoTokenVerifier" as Auth
    component "express-openapi-validator\n(openapi.json)" as Validator
    component "TaskController\n/tasks" as Tasks
    component "ListController\n/lists" as Lists
    component "McpController\n/mcp" as Mcp
    component "DiscoveryController\n/.well-known" as Discovery
    component "TaskService / ListService" as Service
    interface "Task / TodoList\nRepository" as TaskRepository
    component "DynamoRepository" as Repo
  }

  database "DynamoDB\ntasks + lists\nownerId + id" as Table
}

Client --> Cognito : OAuth 2.0 code + PKCE\n(Cognito, Google, Microsoft)
Client --> Cors : HTTPS + Bearer access token
Cors --> Discovery
Cors --> Auth
Auth ..> Cognito : fetch and cache JWKS
Auth --> Validator
Auth --> Mcp
Validator --> Tasks
Validator --> Lists
Tasks --> Service
Lists --> Service
Mcp --> Service
Service --> TaskRepository
Repo ..|> TaskRepository
Repo --> Table
@enduml
