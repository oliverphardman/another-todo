@startuml task-request
title Create task

actor Client
participant "Web Function endpoint" as Endpoint
participant "Express app" as App
participant BearerAuthenticator as Auth
participant "OpenAPI validator" as Validator
participant TaskController
participant TaskService
participant DynamoRepository as Repo
database DynamoDB

Client -> Endpoint : POST /tasks (Bearer access token)
Endpoint -> App : HTTP request on AWS_LAMBDA_HTTP_ENDPOINT
App -> Auth : verify JWT (signature, issuer, client, expiry)
Auth --> App : sub claim as ownerId
App -> Validator : validate body against openapi.json
Validator -> TaskController : valid request
TaskController -> TaskService : create(ownerId, input)
TaskService -> Repo : save(task)
Repo -> DynamoDB : PutItem
TaskController --> Client : 201 Task
@enduml
